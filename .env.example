# Language.fi Production Environment Variables

# Database (PostgreSQL - Neon, Supabase, or self-hosted)
DATABASE_URL=postgresql://user:password@localhost:5432/languagefi

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Language.fi
NODE_ENV=development

# Admin Secrets
ADMIN_SECRET=your-admin-secret
CRON_SECRET=your-cron-secret

# Data Providers
GATEIO_API_BASE=https://api.gateio.ws/api/v4
SOLANA_RPC_URL=
ETHEREUM_RPC_URL=
BASE_RPC_URL=

# CoinGecko API
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=your-coingecko-api-key

# CoinMarketCap API
COINMARKETCAP_API_KEY=your-coinmarketcap-api-key

# Oracle & Contracts
ORACLE_PRIVATE_KEY=your-oracle-private-key
NEXT_PUBLIC_LGU_CONTRACT=
NEXT_PUBLIC_STAKING_CONTRACT=
CHAIN_ID=1

# Stripe Billing
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PRO_PRICE_ID=your-stripe-pro-price-id
STRIPE_ENTERPRISE_PRICE_ID=your-stripe-enterprise-price-id
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# LLM APIs
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
JULES_API_TOKEN=your-jules-api-token

# Platform Tokens
HUGGINGFACE_TOKEN=your-huggingface-token
GITHUB_PAT=your-github-pat
SSH_OLLAMA=your-ssh-key
VERCEL_TOKEN=your-vercel-token
VERCEL_OIDC_TOKEN=your-vercel-oidc-token
NETLIFY_API_KEY=your-netlify-api-key
RENDER_API_KEY=your-render-api-key
RAILWAY_API_KEY=your-railway-api-key

# API Keys (for external services)
DEXSCREENER_API_BASE=https://api.dexscreener.com/latest/dex
ETHERSCAN_API_KEY=your-etherscan-api-key
BASESCAN_API_KEY=your-basescan-api-key
HELIUS_API_KEY=your-helius-api-key
BIRDEYE_API_KEY=your-birdeye-api-key
ALCHEMY_API_KEY=your-alchemy-api-key
MORALIS_API_KEY=your-moralis-api-key
COVALENT_API_KEY=your-covalent-api-key
NEWS_API_KEY=your-news-api-key
NYT_API_KEY=your-nyt-api-key
