# Language.fi Production Environment Variables

# Database (PostgreSQL - Neon, Supabase, or self-hosted)
DATABASE_URL=postgresql://user:password@localhost:5432/languagefi

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Language.fi
NODE_ENV=development

# Admin Secrets
ADMIN_SECRET=supersecret
CRON_SECRET=cronsecret

# Data Providers
GATEIO_API_BASE=https://api.gateio.ws/api/v4
SOLANA_RPC_URL=
ETHEREUM_RPC_URL=
BASE_RPC_URL=

# CoinGecko API
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=your-api-key-here

# CoinMarketCap API
COINMARKETCAP_API_KEY=

# Oracle & Contracts
ORACLE_PRIVATE_KEY=
NEXT_PUBLIC_LGU_CONTRACT=
NEXT_PUBLIC_STAKING_CONTRACT=
CHAIN_ID=1

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# API Keys (for external services)
DEXSCREENER_API_BASE=https://api.dexscreener.com/latest/dex
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
HELIUS_API_KEY=
BIRDEYE_API_KEY=
ALCHEMY_API_KEY=
MORALIS_API_KEY=
COVALENT_API_KEY=
NEWS_API_KEY=
NYT_API_KEY=
