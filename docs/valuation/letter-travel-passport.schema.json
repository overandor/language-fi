{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://language-fi.local/schemas/letter-travel-passport.schema.json",
  "title": "Letter Travel Passport",
  "description": "Event-sourced schema for giving each character a stable ID and an append-only history of where it originated, moved, mutated, appeared, disappeared, gained proof, and changed value.",
  "type": "object",
  "required": ["letter_id", "canonical_character", "origin", "current_state", "travel_history", "lineage", "integrity"],
  "additionalProperties": false,
  "properties": {
    "letter_id": {
      "type": "string",
      "description": "Stable per-character identifier. It should never be reused for a different character instance.",
      "pattern": "^ltr:[a-zA-Z0-9._-]+:[a-zA-Z0-9._/-]+:[0-9]+:[0-9]+:[0-9]+:[a-f0-9]{12,64}$"
    },
    "canonical_character": {
      "type": "object",
      "required": ["glyph", "unicode_codepoint", "utf8_hex", "normalization"],
      "additionalProperties": false,
      "properties": {
        "glyph": { "type": "string", "minLength": 1, "maxLength": 8 },
        "unicode_codepoint": { "type": "string", "description": "Example: U+0061" },
        "utf8_hex": { "type": "string" },
        "normalization": { "type": "string", "enum": ["raw", "NFC", "NFD", "NFKC", "NFKD"] }
      }
    },
    "origin": {
      "type": "object",
      "required": ["surface_type", "path_or_url", "ref", "line", "column", "utf8_offset", "created_at", "evidence_hash"],
      "additionalProperties": false,
      "properties": {
        "surface_type": { "type": "string", "enum": ["repo_file", "diff", "commit", "pull_request", "issue", "document", "deployment", "web_page", "search_result", "local_file", "chat_export", "unknown"] },
        "path_or_url": { "type": "string" },
        "ref": { "type": "string", "description": "Branch, commit SHA, PR number, URL snapshot ID, or local snapshot ID." },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "utf8_offset": { "type": "integer", "minimum": 0 },
        "context_left": { "type": "string" },
        "context_right": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "evidence_hash": { "type": "string" }
      }
    },
    "current_state": {
      "type": "object",
      "required": ["status", "last_seen_at", "last_surface_id", "last_event_id"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["active", "moved", "copied", "mutated", "deleted", "archived", "unresolved"] },
        "last_seen_at": { "type": "string", "format": "date-time" },
        "last_surface_id": { "type": "string" },
        "last_event_id": { "type": "string" },
        "current_value_usd": { "type": "number", "minimum": 0 },
        "current_value_band": { "type": "string", "enum": ["none", "dust", "low", "medium", "high", "exceptional"] }
      }
    },
    "travel_history": {
      "type": "array",
      "description": "Append-only event stream. Never rewrite past travel events; add correction events instead.",
      "items": { "$ref": "#/$defs/travel_event" }
    },
    "lineage": {
      "type": "object",
      "required": ["parent_letter_ids", "child_letter_ids", "sibling_letter_ids", "span_id", "symbol_id"],
      "additionalProperties": false,
      "properties": {
        "parent_letter_ids": { "type": "array", "items": { "type": "string" } },
        "child_letter_ids": { "type": "array", "items": { "type": "string" } },
        "sibling_letter_ids": { "type": "array", "items": { "type": "string" } },
        "span_id": { "type": "string" },
        "symbol_id": { "type": "string" },
        "word_id": { "type": "string" },
        "sentence_id": { "type": "string" },
        "file_id": { "type": "string" },
        "commit_sha": { "type": "string" },
        "pull_request_number": { "type": "integer" }
      }
    },
    "valuation_snapshots": {
      "type": "array",
      "items": { "$ref": "#/$defs/valuation_snapshot" }
    },
    "integrity": {
      "type": "object",
      "required": ["passport_hash", "event_chain_hash", "schema_version"],
      "additionalProperties": false,
      "properties": {
        "passport_hash": { "type": "string" },
        "event_chain_hash": { "type": "string" },
        "schema_version": { "type": "string" },
        "signed_by": { "type": "string" },
        "signature": { "type": "string" }
      }
    }
  },
  "$defs": {
    "travel_event": {
      "type": "object",
      "required": ["event_id", "event_type", "timestamp", "from", "to", "proof", "mutation", "confidence"],
      "additionalProperties": false,
      "properties": {
        "event_id": { "type": "string", "description": "Stable event ID, preferably hash-derived." },
        "event_type": {
          "type": "string",
          "enum": [
            "originated",
            "committed",
            "moved",
            "copied",
            "renamed",
            "mutated",
            "deleted",
            "restored",
            "merged",
            "deployed",
            "indexed",
            "ranked",
            "cited",
            "valued",
            "reviewed",
            "disputed",
            "corrected"
          ]
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "from": { "$ref": "#/$defs/surface_position" },
        "to": { "$ref": "#/$defs/surface_position" },
        "transport": { "type": "string", "enum": ["git", "copy_paste", "build", "deploy", "crawler", "search_index", "manual_reference", "unknown"] },
        "proof": { "$ref": "#/$defs/proof_ref" },
        "mutation": { "$ref": "#/$defs/mutation_ref" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": "string" }
      }
    },
    "surface_position": {
      "type": "object",
      "required": ["surface_id", "surface_type", "path_or_url"],
      "additionalProperties": false,
      "properties": {
        "surface_id": { "type": "string" },
        "surface_type": { "type": "string" },
        "path_or_url": { "type": "string" },
        "ref": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "utf8_offset": { "type": "integer", "minimum": 0 },
        "dom_selector": { "type": "string" },
        "search_query": { "type": "string" },
        "search_rank": { "type": "integer", "minimum": 1 },
        "viewport_zone": { "type": "string" }
      }
    },
    "proof_ref": {
      "type": "object",
      "required": ["proof_type", "proof_hash"],
      "additionalProperties": false,
      "properties": {
        "proof_type": { "type": "string", "enum": ["file_hash", "commit", "pull_request", "ci_log", "deployment", "screenshot", "search_receipt", "external_url", "manual_review", "none"] },
        "proof_url": { "type": "string" },
        "proof_hash": { "type": "string" },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "mutation_ref": {
      "type": "object",
      "required": ["mutation_type"],
      "additionalProperties": false,
      "properties": {
        "mutation_type": { "type": "string", "enum": ["none", "case_change", "unicode_normalized", "renamed", "deleted", "inserted", "substituted", "compressed", "expanded", "semantic_rewrite"] },
        "before": { "type": "string" },
        "after": { "type": "string" },
        "edit_distance": { "type": "integer", "minimum": 0 },
        "semantic_preservation": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "valuation_snapshot": {
      "type": "object",
      "required": ["valuation_id", "timestamp", "source_model", "value_usd", "value_band", "evidence_ref"],
      "additionalProperties": false,
      "properties": {
        "valuation_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "source_model": { "type": "string", "enum": ["letter-price-ledger", "registry-oracle", "contributor-artifact-account", "manual_review"] },
        "value_usd": { "type": "number", "minimum": 0 },
        "value_band": { "type": "string", "enum": ["none", "dust", "low", "medium", "high", "exceptional"] },
        "evidence_ref": { "type": "string" },
        "risk_discount": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
